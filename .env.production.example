# =============================================================================
# Plantilla para un servidor propio con Docker Compose (compose.deploy.yml).
# Copia a .env en el servidor, cambia TODOS los valores y no la subas a Git.
# Para Render + Vercel no se usa este archivo: ver render.yaml y el README.
# =============================================================================
GHCR_OWNER=tu_usuario_github_en_minusculas
IMAGE_TAG=main

POSTGRES_DB=servicestech
DB_USER=servicestech
DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ALEATORIA_LARGA

ADMIN_EMAIL=admin@tu-dominio.pe
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ADMIN_UNICA

# openssl rand -base64 32
APP_JWT_SECRET=CAMBIAR_POR_EL_RESULTADO_DE_OPENSSL_RAND_BASE64_32

FRONTEND_ORIGINS=https://tu-dominio.pe
FRONTEND_PORT=80
# Delante del puerto 80 coloca un proxy con HTTPS (Caddy, Traefik o Nginx con certificado).
