# Copiar manualmente a /opt/servicestech/.env en el servidor y NO subir a Git.
# Requiere Docker Engine y plugin docker compose en la maquina remota.
GHCR_OWNER=tu_usuario_github_en_minusculas
IMAGE_TAG=main
POSTGRES_DB=servicestech
DB_USER=servicestech
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_ALEATORIA_LARGA
ADMIN_EMAIL=admin@admin.com
# NO publicar la clave de demostracion 'admin123456789' en internet.
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_ADMIN_UNICA_LARGA
FRONTEND_PORT=80
# En un despliegue real utiliza un proxy inverso con TLS/HTTPS delante del frontend.
