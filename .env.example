# =============================================================================
# SOLO DESARROLLO LOCAL. Copia este archivo como .env (cp .env.example .env).
# Nunca uses estas claves en un servidor accesible desde Internet.
# =============================================================================
COMPOSE_PROJECT_NAME=servicestech

# PostgreSQL
POSTGRES_DB=servicestech
DB_USER=servicestech
DB_PASSWORD=solo_desarrollo_123

# Puertos publicados en tu equipo (solo 127.0.0.1 para la base y el backend)
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8088

# Administrador inicial (se crea en el primer arranque si el correo no existe)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123456789

# Firma de los JWT: Base64 de al menos 32 bytes. Genera uno propio con:  openssl rand -base64 32
APP_JWT_SECRET=ZGVzYXJyb2xsby1sb2NhbC1zZXJ2aWNlc3RlY2gtMzJieXRlcyE=

# Orígenes permitidos si alguien llama al backend directamente (con Nginx/Vite no hace falta)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088
